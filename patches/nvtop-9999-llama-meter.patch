+#ifndef NVTOP_MODEL_METER_C_H__
+#define NVTOP_MODEL_METER_C_H__
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define NVTOP_LLM_MAX_SERVERS 4
+#define NVTOP_LLM_SERVER_NAME_MAX 24
+#define NVTOP_LLM_GPU_HINT_MAX 32
+#define NVTOP_LLM_MODEL_NAME_MAX 192
+#define NVTOP_LLM_FTYPE_MAX 32
+#define NVTOP_LLM_KVTYPE_MAX 12
+
+/* A router can serve several models at once (llama.cpp `max_instances`), so
+ * one server holds a list of them. */
+#define NVTOP_LLM_MAX_LOADED 4
+
+/* State of one model on a router */
+typedef enum {
+  NVTOP_LLM_SERVER_DOWN = 0, /* nothing answered on the socket */
+  NVTOP_LLM_IDLE,            /* router answered, this model is not running */
+  NVTOP_LLM_LOADING,
+  NVTOP_LLM_LOADED,
+} nvtop_llm_state;
+
+/* One model instance on a router */
+typedef struct nvtop_llm_model {
+  char model_name[NVTOP_LLM_MODEL_NAME_MAX];
+  nvtop_llm_state state;
+
+  /* Static facts, from meta{} (falls back to status.args) */
+  unsigned ctx_size;  /* meta.n_ctx / --ctx-size */
+  unsigned ctx_train; /* meta.n_ctx_train */
+  unsigned parallel;  /* --parallel */
+  char kv_type_k[NVTOP_LLM_KVTYPE_MAX];
+  char kv_type_v[NVTOP_LLM_KVTYPE_MAX];
+  uint64_t model_size_bytes;       /* meta.size */
+  uint64_t n_params;               /* meta.n_params */
+  char ftype[NVTOP_LLM_FTYPE_MAX]; /* meta.ftype */
+  char model_arg[NVTOP_LLM_MODEL_NAME_MAX]; /* status.args --model, e.g. "./X.gguf" */
+
+  /* Live context load, best effort (/metrics?model=...). The router returns
+   * HTTP 500 when the child instance is not reachable, in which case
+   * has_live_ctx stays false and the UI shows the static facts instead. */
+  bool has_live_ctx;
+  unsigned kv_usage_pct;
+  uint64_t kv_tokens;
+  uint64_t kv_tokens_total;
+
+  /* Cold-load progress, read from /proc: the per-model llama-server child's
+   * read_bytes against the size of the GGUF it was told to load. That is only a
+   * valid signal because models.ini sets `load-mode = dio` -- DirectIO sends
+   * every byte through the block layer, so read_bytes advances with the load.
+   * Under mmap loading the counter stalls, which is reported as stalled rather
+   * than as a frozen percentage. Note read_bytes also counts the process's
+   * other reads, so it can pass the file size and the percentage is clamped. */
+  bool has_load_progress;
+  bool load_stalled;
+  unsigned load_pct;
+  uint64_t load_read_bytes;
+  uint64_t load_total_bytes;
+  double load_bytes_per_s; /* 0 until two samples exist */
+  double load_eta_s;       /* 0 when unknown */
+
+  /* Prefill progress for the request in flight, from /slots?model=... . Unlike
+   * the load bar this is an exact API figure rather than an inference: the
+   * router reports how long the task's prompt is and how much of it is done.
+   * On a router, /slots needs ?model= (bare /slots answers HTTP 400). */
+  bool has_prefill;
+  unsigned prefill_pct;
+  unsigned long prefill_total;     /* n_prompt_tokens */
+  unsigned long prefill_processed; /* n_prompt_tokens_processed */
+  unsigned long prefill_cached;    /* n_prompt_tokens_cache */
+  long prefill_task;               /* id_task: changes with each request */
+  bool slot_processing;            /* is_processing: true while decoding too */
+  double prefill_tok_per_s;        /* 0 until two samples of the same task */
+  double prefill_eta_s;            /* 0 when unknown */
+} nvtop_llm_model;
+
+/* One frame of progress-bar easing.
+ *
+ * llama.cpp's processed-token counter advances a whole logical batch at a time
+ * (-b, 2048 by default), so on fast hardware the figure the router reports jumps
+ * several percent at once and a bar drawn straight from it moves in lurches. The
+ * bar is eased towards the reported value instead, so it advances every frame
+ * while the printed percentage and token counts stay exactly what was reported.
+ *
+ * Pure, so it can be tested on its own: never downwards, never past the target,
+ * and a value that has gone backwards (a new request) is taken immediately
+ * rather than eased. */
+static inline double nvtop_llm_ease_step(double shown, double target) {
+  if (target <= shown)
+    return target;
+  shown += (target - shown) * 0.25;
+  if (target - shown < 0.4)
+    shown = target;
+  return shown;
+}
+
+/* One llama.cpp router server, mapped to one GPU */
+typedef struct nvtop_model_meter_info {
+  char server_name[NVTOP_LLM_SERVER_NAME_MAX]; /* "llama" */
+  char gpu_hint[NVTOP_LLM_GPU_HINT_MAX];       /* substring matched in the GPU name */
+  bool reachable;
+
+  /* Aggregate over models[]: LOADED if any is loaded, LOADING if any is
+   * loading, IDLE if the router answered with nothing running. */
+  nvtop_llm_state state;
+
+  unsigned preset_count; /* how many models the router advertises */
+  unsigned loaded_count; /* valid entries in models[] */
+  nvtop_llm_model models[NVTOP_LLM_MAX_LOADED];
+} nvtop_model_meter_info;
+
+/* Poll every configured server. Cheap no-op when called more often than the
+ * internal minimum interval. Returns true if at least one server answered. */
+bool nvtop_model_meter_poll(void);
+
+/* Number of servers that have been polled */
+unsigned nvtop_model_meter_count(void);
+
+/* Info for server idx, or NULL when out of range */
+const nvtop_model_meter_info *nvtop_model_meter_get(unsigned idx);
+
+/* Best match for a GPU device name (e.g. "AMD Radeon RX 7900 XT" -> llama),
+ * or NULL when no configured server maps to that GPU. */
+const nvtop_model_meter_info *nvtop_model_meter_for_gpu(const char *gpu_name);
+
+/* True when a router is configured for this GPU name. Does not poll, so it can
+ * be asked while the display is being laid out. */
+bool nvtop_model_meter_has_router_for_gpu(const char *gpu_name);
+
+void nvtop_model_meter_shutdown(void);
+
+/* ------------------------------------------------------------------ */
+/* Stable-diffusion servers                                            */
+/* ------------------------------------------------------------------ */
+/* stable-diffusion.cpp's sd-server speaks an A1111-shaped API, which is a
+ * different status model from a llama.cpp router: there is one checkpoint and
+ * one queue, not a list of models. Status is read from /sdapi/v1/options
+ * (which checkpoint) and /sdapi/v1/progress (job state). Its /v1/models answers
+ * llama-style but carries a single `sd-cpp-local` with no status field at all,
+ * so the name comes from sd_model_checkpoint instead. */
+
+#define NVTOP_SD_MAX_SERVERS 4
+#define NVTOP_SD_CHECKPOINT_MAX 128
+
+typedef struct nvtop_sd_info {
+  char server_name[NVTOP_LLM_SERVER_NAME_MAX];
+  char gpu_hint[NVTOP_LLM_GPU_HINT_MAX];
+  bool reachable;
+  char checkpoint[NVTOP_SD_CHECKPOINT_MAX]; /* sd_model_checkpoint */
+  bool generating;                          /* a job is in flight */
+  unsigned progress_pct;                    /* sampling progress, 0..100 */
+  unsigned step;                            /* sampling_step */
+  unsigned steps;                           /* sampling_steps */
+  unsigned job_count;                       /* queued + running */
+  double eta_s;                             /* eta_relative, 0 when unknown */
+} nvtop_sd_info;
+
+/* Polled from inside nvtop_model_meter_poll() so it shares the cadence. */
+void nvtop_sd_meter_poll(void);
+/* Configured server for this GPU, whether or not it answers. */
+const nvtop_sd_info *nvtop_sd_meter_for_gpu(const char *gpu_name);
+/* Answered from the static config, so the layout can ask before any poll. */
+bool nvtop_sd_meter_has_server_for_gpu(const char *gpu_name);
+
+#endif /* NVTOP_MODEL_METER_C_H__ */
