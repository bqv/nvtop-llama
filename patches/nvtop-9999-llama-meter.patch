+#define LLM_MODELS_PATH "/v1/models"
+#define LLM_BODY_MAX (512u * 1024u)
+/*
+ * Poll cadence. The meter is redrawn at nvtop's refresh rate (0.1 s by
+ * default), so a fixed 1.2 s poll was what made the bars look like ~1 fps: the
+ * frames were there, the numbers were not. Polling quickly also costs the
+ * router a moment on its task lock, so the fast tier is reserved for the states
+ * worth watching and idle is deliberately slow.
+ */
+#define LLM_POLL_FAST_MS 300   /* a model is loading, or a prompt is being read */
+#define LLM_POLL_ACTIVE_MS 900 /* a loaded model is decoding */
+#define LLM_POLL_IDLE_MS 2000  /* loaded, nothing in flight */
+#define LLM_POLL_COLD_MS 5000  /* nothing loaded, or the router is not answering */
+
+static unsigned g_poll_ms = LLM_POLL_IDLE_MS;
+
+/* When a router cannot serve /metrics, do not retry it on every single poll:
+ * each refused request lands in the router log. */
+#define LLM_METRICS_BACKOFF_POLLS 25
+
