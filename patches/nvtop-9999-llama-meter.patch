+/* ------------------------------------------------------------------ */
+/* LLM model meter                                                     */
+/* ------------------------------------------------------------------ */
+
+static void llm_append(char *buf, size_t cap, const char *fmt, ...) {
+  size_t len = strlen(buf);
+  va_list ap;
+
+  if (len + 1 >= cap)
+    return;
+  va_start(ap, fmt);
+  vsnprintf(buf + len, cap - len, fmt, ap);
+  va_end(ap);
+}
+
+static void llm_fmt_count(char *out, size_t cap, uint64_t v) {
+  if (v >= 1000000000ull)
+    snprintf(out, cap, "%.1fB", (double)v / 1000000000.0);
+  else if (v >= 1000000ull)
+    snprintf(out, cap, "%.1fM", (double)v / 1000000.0);
+  else if (v >= 1000ull)
+    snprintf(out, cap, "%.1fk", (double)v / 1000.0);
+  else
+    snprintf(out, cap, "%llu", (unsigned long long)v);
+}
+
+static void llm_fmt_bytes(char *out, size_t cap, uint64_t v) {
+  if (v >= 1000000000ull)
+    snprintf(out, cap, "%.1fG", (double)v / 1000000000.0);
+  else if (v >= 1000000ull)
+    snprintf(out, cap, "%.0fM", (double)v / 1000000.0);
+  else
+    snprintf(out, cap, "%.0fK", (double)v / 1000.0);
+}
+
+/* Compact facts for one model. `full` adds the training context, parameter
+ * count, quantisation and KV cache types, which only fit on a dedicated row. */
+static void llm_model_facts(const nvtop_llm_model *m, char *out, size_t cap, bool full) {
+  char tmp[32];
+
+  out[0] = '\0';
+  if (m->ctx_size) {
+    llm_fmt_count(tmp, sizeof(tmp), m->ctx_size);
+    llm_append(out, cap, "ctx %s", tmp);
+  }
+  if (full && m->ctx_train) {
+    llm_fmt_count(tmp, sizeof(tmp), m->ctx_train);
+    llm_append(out, cap, "  train %s", tmp);
+  }
+  if (m->model_size_bytes) {
+    llm_fmt_bytes(tmp, sizeof(tmp), m->model_size_bytes);
+    llm_append(out, cap, "  %s", tmp);
+  }
+  if (full && m->n_params) {
+    llm_fmt_count(tmp, sizeof(tmp), m->n_params);
+    llm_append(out, cap, "  %s", tmp);
+  }
+  if (full && m->parallel > 1) {
+    snprintf(tmp, sizeof(tmp), "%u", m->parallel);
+    llm_append(out, cap, "  slots %s", tmp);
+  }
+  if (full && m->ftype[0])
+    llm_append(out, cap, "  %s", m->ftype);
+  if (full && m->kv_type_k[0] && m->kv_type_v[0])
+    llm_append(out, cap, "  kv %s/%s", m->kv_type_k, m->kv_type_v);
+}
+
+/* Live KV-cache load bar, drawn like the GPU/MEM meters. */
+static void llm_draw_ctx_bar(WINDOW *win, int row, int cols, const nvtop_llm_model *m) {
+  char pct[16], tail[128];
+  int label = 4, bar, filled;
+
+  snprintf(pct, sizeof(pct), "%u%%", m->kv_usage_pct);
+  if (m->kv_tokens_total)
+    snprintf(tail, sizeof(tail), " %s  %llu/%llu", pct, (unsigned long long)m->kv_tokens,
+             (unsigned long long)m->kv_tokens_total);
+  else
+    snprintf(tail, sizeof(tail), " %s", pct);
+
+  bar = cols - label - 3 - (int)strlen(tail);
+  if (bar < 1)
+    bar = 1;
+  filled = (int)((double)bar * (double)m->kv_usage_pct / 100.0);
+  if (filled > bar)
+    filled = bar;
+
+  wcolor_set(win, cyan_color, NULL);
+  mvwprintw(win, row, 0, "CTX");
+  wstandend(win);
+  mvwaddch(win, row, label, '[');
+  if (filled > 0)
+    whline(win, '|', filled);
+  if (bar - filled > 0)
+    mvwhline(win, row, label + 1 + filled, ' ', bar - filled);
+  mvwaddch(win, row, label + 1 + bar, ']');
+  mvwprintw(win, row, label + 2 + bar, "%.*s", cols - (label + 2 + bar) - 1, tail);
+}
+
+/*
+ * The router's processed-token counter is quantised by llama.cpp's logical batch
+ * (-b, 2048 by default): it advances a whole batch at a time, which on a fast GPU
+ * is a jump of several percent roughly every 0.6 s -- only ~21 steps for a 43k
+ * prompt. No polling makes that finer, so the bar is eased towards the last value
+ * the router reported instead: it then moves every frame, while the printed
+ * percentage and the token counts stay exactly what was reported. The fill trails
+ * the number by less than one batch, which is not visible.
+ */
+#define LLM_EASE_MAX 8
+static struct {
+  char key[NVTOP_LLM_MODEL_NAME_MAX * 2];
+  long task;
+  double shown;
+} g_ease[LLM_EASE_MAX];
+
+static double llm_ease_fill(const char *server, const nvtop_llm_model *m) {
+  char key[NVTOP_LLM_MODEL_NAME_MAX * 2];
+  double target = (double)m->prefill_pct;
+  unsigned slot = LLM_EASE_MAX, free_slot = LLM_EASE_MAX;
+
+  snprintf(key, sizeof(key), "%s/%s", server, m->model_name);
+  for (unsigned i = 0; i < LLM_EASE_MAX; i++) {
+    if (g_ease[i].key[0] && strcmp(g_ease[i].key, key) == 0) {
+      slot = i;
+      break;
+    }
+    if (free_slot == LLM_EASE_MAX && !g_ease[i].key[0])
+      free_slot = i;
+  }
+  if (slot == LLM_EASE_MAX) {
+    slot = free_slot == LLM_EASE_MAX ? 0 : free_slot;
+    snprintf(g_ease[slot].key, sizeof(g_ease[slot].key), "%s", key);
+    g_ease[slot].task = m->prefill_task;
+    g_ease[slot].shown = target;
+    return target; /* first sighting: nothing to ease towards */
+  }
+  if (g_ease[slot].task != m->prefill_task) {
+    g_ease[slot].task = m->prefill_task; /* a new request: start from the truth */
+    g_ease[slot].shown = target;
+    return target;
+  }
+  g_ease[slot].shown = nvtop_llm_ease_step(g_ease[slot].shown, target);
+  return g_ease[slot].shown;
+}
+
+/* Bar renderer for the meters that are just label + fill + text. */
+static void llm_draw_bar(WINDOW *win, int row, int cols, const char *label,
+                         unsigned pct, const char *tail) {
+  int lw = (int)strlen(label), draw, filled;
+
+  draw = cols - lw - 3 - (int)strlen(tail);
+  if (draw < 1)
+    draw = 1;
+  filled = (int)((double)draw * (double)pct / 100.0);
+  if (filled > draw)
+    filled = draw;
+
+  wcolor_set(win, cyan_color, NULL);
+  mvwprintw(win, row, 0, "%s", label);
+  wstandend(win);
+  mvwaddch(win, row, lw, '[');
+  if (filled > 0)
+    whline(win, '|', filled);
+  if (draw - filled > 0)
+    mvwhline(win, row, lw + 1 + filled, ' ', draw - filled);
+  mvwaddch(win, row, lw + 1 + draw, ']');
+  mvwprintw(win, row, lw + 2 + draw, "%.*s", cols - (lw + 2 + draw) - 1, tail);
+}
+
+/*
+ * Stable-diffusion status, on the same two rows as the LLM meter: what is
+ * loaded, then how far the job in flight has got.
+ *   SD sd  Qwen_Image-Q4_K_M
+ *   DIFF[||||||        ] 42%  step 8/20  eta 3m
+ *
+ * Sampling progress is exact from the API. There is no state for the model
+ * load, which is the slow part, so that shows as idle rather than as a number
+ * invented here.
+ */
+static void draw_sd_meter(WINDOW *win, const nvtop_sd_info *sd) {
+  int rows, cols;
+  char line[512], tail[192];
+
+  getmaxyx(win, rows, cols);
+  werase(win);
+  if (cols <= 8)
+    return;
+
+  wcolor_set(win, cyan_color, NULL);
+  mvwprintw(win, 0, 0, "SD");
+  wstandend(win);
+
+  line[0] = '\0';
+  llm_append(line, sizeof(line), " %s", sd->server_name);
+  if (!sd->reachable)
+    llm_append(line, sizeof(line), "  not reachable");
+  else if (sd->checkpoint[0])
+    llm_append(line, sizeof(line), "  %s", sd->checkpoint);
+  else
+    llm_append(line, sizeof(line), "  no checkpoint reported");
+  mvwprintw(win, 0, 2, "%.*s", cols - 3, line);
+
+  if (rows < 2) {
+    wnoutrefresh(win);
+    return;
+  }
+
+  if (!sd->reachable) {
+    snprintf(line, sizeof(line), "nothing answered on the sd socket");
+    mvwprintw(win, 1, 0, "%.*s", cols - 1, line);
+  } else if (sd->generating) {
+    snprintf(tail, sizeof(tail), " %u%%", sd->progress_pct);
+    if (sd->steps)
+      llm_append(tail, sizeof(tail), "  step %u/%u", sd->step, sd->steps);
+    if (sd->job_count > 1)
+      llm_append(tail, sizeof(tail), "  %u queued", sd->job_count - 1);
+    if (sd->eta_s > 0.0)
+      llm_append(tail, sizeof(tail), "  eta %.0fs", sd->eta_s);
+    llm_draw_bar(win, 1, cols, "DIFF", sd->progress_pct, tail);
+  } else {
+    snprintf(line, sizeof(line), "idle, no job in flight");
+    mvwprintw(win, 1, 0, "%.*s", cols - 1, line);
+  }
+  wnoutrefresh(win);
+}
+
+/* Prefill progress bar, drawn on the same row as the others: how much of the
+ * request's prompt the router has read. Exact, straight from /slots. */
+static void llm_draw_prefill_bar(WINDOW *win, int row, int cols, const char *server,
+                                 const nvtop_llm_model *m) {
+  char tail[192];
+  int label = 4, bar, filled;
+
+  snprintf(tail, sizeof(tail), " %u%%  %.1fk/%.1fk tokens", m->prefill_pct,
+           (double)m->prefill_processed / 1000.0, (double)m->prefill_total / 1000.0);
+  if (m->prefill_cached)
+    llm_append(tail, sizeof(tail), "  %.1fk cached", (double)m->prefill_cached / 1000.0);
+  if (m->prefill_tok_per_s > 0)
+    llm_append(tail, sizeof(tail), "  %.0f tok/s", m->prefill_tok_per_s);
+  if (m->prefill_eta_s > 0)
+    llm_append(tail, sizeof(tail), "  eta %.0fs", m->prefill_eta_s);
+
+  bar = cols - label - 3 - (int)strlen(tail);
+  if (bar < 1)
+    bar = 1;
+  /* Only the fill is eased; the numbers above are the router's own. */
+  filled = (int)((double)bar * llm_ease_fill(server, m) / 100.0);
+  if (filled > bar)
+    filled = bar;
+
+  wcolor_set(win, cyan_color, NULL);
+  mvwprintw(win, row, 0, "PREF");
+  wstandend(win);
+  mvwaddch(win, row, label, '[');
+  if (filled > 0)
+    whline(win, '|', filled);
+  if (bar - filled > 0)
+    mvwhline(win, row, label + 1 + filled, ' ', bar - filled);
+  mvwaddch(win, row, label + 1 + bar, ']');
+  mvwprintw(win, row, label + 2 + bar, "%.*s", cols - (label + 2 + bar) - 1, tail);
+}
+
+/* Cold-load progress bar. Not the context bar: this counts bytes of the GGUF
+ * the child has actually read, so it is only shown while a load is in flight
+ * and only when the counter is genuinely moving. */
+static void llm_draw_load_bar(WINDOW *win, int row, int cols, const nvtop_llm_model *m) {
+  char tail[192];
+  int label = 4, bar, filled;
+
+  if (m->load_stalled) {
+    snprintf(tail, sizeof(tail), " no read progress (load-mode not dio?)");
+  } else {
+    /* read_bytes counts the process's other reads too, so it can pass the file
+     * size: never show more read than there is to read. */
+    uint64_t shown = m->load_read_bytes < m->load_total_bytes ? m->load_read_bytes : m->load_total_bytes;
+    snprintf(tail, sizeof(tail), " %u%%  %.1f/%.1f GiB", m->load_pct,
+             (double)shown / 1073741824.0, (double)m->load_total_bytes / 1073741824.0);
+    if (m->load_bytes_per_s > 0)
+      llm_append(tail, sizeof(tail), "  %.0f MB/s", m->load_bytes_per_s / 1e6);
+    if (m->load_eta_s > 0)
+      llm_append(tail, sizeof(tail), "  eta %.0fs", m->load_eta_s);
+  }
+
+  bar = cols - label - 3 - (int)strlen(tail);
+  if (bar < 1)
+    bar = 1;
+  filled = (int)((double)bar * (double)m->load_pct / 100.0);
+  if (filled > bar)
+    filled = bar;
+
+  wcolor_set(win, cyan_color, NULL);
+  mvwprintw(win, row, 0, "LOAD");
+  wstandend(win);
+  mvwaddch(win, row, label, '[');
+  if (filled > 0)
+    whline(win, '|', filled);
+  if (bar - filled > 0)
+    mvwhline(win, row, label + 1 + filled, ' ', bar - filled);
+  mvwaddch(win, row, label + 1 + bar, ']');
+  mvwprintw(win, row, label + 2 + bar, "%.*s", cols - (label + 2 + bar) - 1, tail);
+}
+
+/*
+ * One line per model the router is running, e.g. on the GT 1030:
+ *   LLM llamb  granite-docling-258M-Q8_0     ctx 8k   258M
+ *   LLM llamb  Qwen3-Embedding-0.6B-Q8_0     ctx 4k   633M
+ *
+ * With a single model there is room to spare, so the name gets its own line
+ * and the second line shows either the live context bar or the full facts:
+ *   LLM llama  Qwen3.5-35B-A3B-UD-IQ4_XS-240k
+ *   CTX [||||||||        ] 41%  1234/245760
+ */
+static void draw_llm_meter(WINDOW *win, const nvtop_model_meter_info *info,
+                           const nvtop_sd_info *sd) {
+  int rows, cols;
+  char line[512], facts[256];
+
+  getmaxyx(win, rows, cols);
+  werase(win);
+  if (cols <= 8)
+    return;
+
+  /* No router on the socket, or nothing running. */
+  if (info->state == NVTOP_LLM_SERVER_DOWN || info->loaded_count == 0) {
+    wcolor_set(win, cyan_color, NULL);
+    mvwprintw(win, 0, 0, "LLM");
+    wstandend(win);
+    if (info->state == NVTOP_LLM_SERVER_DOWN)
+      snprintf(line, sizeof(line), " %s  router not reachable", info->server_name);
+    else
+      snprintf(line, sizeof(line), " %s  idle, none loaded", info->server_name);
+    mvwprintw(win, 0, 3, "%.*s", cols - 4, line);
+
+    if (rows >= 2) {
+      if (info->state == NVTOP_LLM_SERVER_DOWN)
+        snprintf(line, sizeof(line), "no connection to the router");
+      else
+        snprintf(line, sizeof(line), "%u presets advertised, loaded on demand", info->preset_count);
+      /* The diffusion server shares this band, so while it is idle its
+       * checkpoint is noted here rather than being invisible. */
+      if (sd && sd->reachable && sd->checkpoint[0])
+        llm_append(line, sizeof(line), "   | SD %s", sd->checkpoint);
+      mvwprintw(win, 1, 0, "%.*s", cols - 1, line);
+    }
+    wnoutrefresh(win);
+    return;
+  }
+
+  /* Exactly one model: name on line 0, details on line 1. */
+  if (info->loaded_count == 1 && rows >= 2) {
+    const nvtop_llm_model *m = &info->models[0];
+
+    wcolor_set(win, cyan_color, NULL);
+    mvwprintw(win, 0, 0, "LLM");
+    wstandend(win);
+
+    line[0] = '\0';
+    llm_append(line, sizeof(line), " %s", info->server_name);
+    if (m->state == NVTOP_LLM_LOADING)
+      llm_append(line, sizeof(line), " loading");
+    llm_append(line, sizeof(line), "  %s", m->model_name);
+    mvwprintw(win, 0, 3, "%.*s", cols - 4, line);
+
+    if (m->state == NVTOP_LLM_LOADING) {
+      /* meta{} is absent until the load finishes, so the facts line has nothing
+       * to say here -- show how far the load has got instead. */
+      if (m->has_load_progress || m->load_stalled)
+        llm_draw_load_bar(win, 1, cols, m);
+      else
+        mvwprintw(win, 1, 0, "%.*s", cols - 1, "reading weights, no progress signal yet");
+    } else if (m->has_prefill) {
+      /* A prompt being read is more interesting than how full the window is. */
+      llm_draw_prefill_bar(win, 1, cols, info->server_name, m);
+    } else if (m->has_live_ctx) {
+      llm_draw_ctx_bar(win, 1, cols, m);
+    } else {
+      llm_model_facts(m, facts, sizeof(facts), true);
+      mvwprintw(win, 1, 0, "%.*s", cols - 1, facts[0] ? facts : "model loaded");
+    }
+    wnoutrefresh(win);
+    return;
+  }
+
+  /* Several models running at once (llama.cpp `max_instances`): one line each,
+   * facts inline, truncated if they do not all fit. */
+  for (int r = 0; r < rows && (unsigned)r < info->loaded_count; r++) {
+    const nvtop_llm_model *m = &info->models[r];
+    unsigned remaining = info->loaded_count - (unsigned)r - 1;
+
+    llm_model_facts(m, facts, sizeof(facts), false);
+
+    line[0] = '\0';
+    llm_append(line, sizeof(line), " %s", info->server_name);
+    if (m->state == NVTOP_LLM_LOADING)
+      llm_append(line, sizeof(line), " loading");
+    llm_append(line, sizeof(line), "  %s", m->model_name);
+    if (facts[0])
+      llm_append(line, sizeof(line), "  %s", facts);
+    if (m->has_prefill)
+      llm_append(line, sizeof(line), "  prefill %u%%", m->prefill_pct);
+    if (m->state == NVTOP_LLM_LOADING && m->has_load_progress)
+      llm_append(line, sizeof(line), "  load %u%%", m->load_pct);
+    else if (m->state == NVTOP_LLM_LOADING && m->load_stalled)
+      llm_append(line, sizeof(line), "  load stalled");
+    if (m->has_live_ctx)
+      llm_append(line, sizeof(line), "  kv %u%%", m->kv_usage_pct);
+    /* Never let a running model vanish silently when there are more of them
+     * than there are rows to show them on. */
+    if (r == rows - 1 && remaining > 0)
+      llm_append(line, sizeof(line), "  +%u more", remaining);
+
+    if (r == 0) {
+      wcolor_set(win, cyan_color, NULL);
+      mvwprintw(win, r, 0, "LLM");
+      wstandend(win);
+    }
+    mvwprintw(win, r, 3, "%.*s", cols - 4, line);
+  }
+
+  wnoutrefresh(win);
+}
