+/* ------------------------------------------------------------------ */
+/* Server <-> GPU mapping                                              */
+/* ------------------------------------------------------------------ */
+
+struct server_def {
+  char name[NVTOP_LLM_SERVER_NAME_MAX]; /* label shown in the meter */
+  char host[64];                        /* host:port of the router  */
+  char gpu_hint[NVTOP_LLM_GPU_HINT_MAX]; /* substring of the GPU name */
+};
+
+static struct server_def g_defs[NVTOP_LLM_MAX_SERVERS] = {
+    {"llama", "127.0.0.1:55555", "7900"},
+    {"llamb", "127.0.0.1:55556", "1030"},
+};
+static unsigned g_def_count = 2;
+
+/* sd_server (stable-diffusion.cpp) -- see nvtop_sd_meter_poll(). Same config
+ * shape as above: NVTOP_SD_SERVERS="sd=127.0.0.1:55557=7900" */
+static struct server_def g_sd_defs[NVTOP_SD_MAX_SERVERS] = {
+    {"sd", "127.0.0.1:55557", "7900"},
+};
+static unsigned g_sd_def_count = 1;
+static nvtop_sd_info g_sd[NVTOP_SD_MAX_SERVERS];
+static bool g_sd_ready = false;
+
+/*
+ * Optional override, so the routers can be moved without a rebuild:
+ *   NVTOP_LLM_SERVERS="llama=127.0.0.1:55555=7900;llamb=127.0.0.1:55556=1030"
+ * The third field is a substring matched against the GPU device name to decide
+ * which GPU block the meter belongs to.
+ */
+/* "name=host:port=hint", semicolon separated. Shared by both server kinds. */
+static void parse_servers(const char *env, struct server_def *defs,
+                          unsigned *count, unsigned max) {
+  const char *p = env;
+  unsigned n = 0;
+
+  while (*p && n < max) {
+    char buf[256];
+    size_t len = 0;
+    char *eq1, *eq2, *hint = NULL;
+
+    while (*p && *p != ';' && len < sizeof(buf) - 1)
+      buf[len++] = *p++;
+    buf[len] = '\0';
+    if (*p == ';')
+      p++;
+    if (!buf[0])
+      continue;
+
+    eq1 = strchr(buf, '=');
+    if (!eq1)
+      continue;
+    *eq1 = '\0';
+    eq2 = strchr(eq1 + 1, '=');
+    if (eq2) {
+      *eq2 = '\0';
+      hint = eq2 + 1;
+    }
+
+    snprintf(defs[n].name, sizeof(defs[n].name), "%s", buf);
+    snprintf(defs[n].host, sizeof(defs[n].host), "%s", eq1 + 1);
+    snprintf(defs[n].gpu_hint, sizeof(defs[n].gpu_hint), "%s", hint ? hint : "");
+    n++;
+  }
+  if (n)
+    *count = n;
+}
+
+static void servers_init(void) {
+  static bool done = false;
+  const char *env;
+
+  if (done)
+    return;
+  done = true;
+
+  env = getenv("NVTOP_LLM_SERVERS");
+  if (!env || !*env)
+    return;
+  parse_servers(env, g_defs, &g_def_count, NVTOP_LLM_MAX_SERVERS);
+}
+
+static void sd_servers_init(void) {
+  static bool done = false;
+  const char *env;
+
+  if (done)
+    return;
+  done = true;
+
+  env = getenv("NVTOP_SD_SERVERS");
+  if (!env || !*env)
+    return;
+  parse_servers(env, g_sd_defs, &g_sd_def_count, NVTOP_SD_MAX_SERVERS);
+}
