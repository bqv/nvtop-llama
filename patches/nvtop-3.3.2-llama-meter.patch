+/* ------------------------------------------------------------------ */
+/* Server <-> GPU mapping                                              */
+/* ------------------------------------------------------------------ */
+
+struct server_def {
+  char name[NVTOP_LLM_SERVER_NAME_MAX]; /* label shown in the meter */
+  char host[64];                        /* host:port of the router  */
+  char gpu_hint[NVTOP_LLM_GPU_HINT_MAX]; /* substring of the GPU name */
+};
+
+static struct server_def g_defs[NVTOP_LLM_MAX_SERVERS] = {
+    {"llama", "127.0.0.1:55555", "7900"},
+    {"llamb", "127.0.0.1:55556", "1030"},
+};
+static unsigned g_def_count = 2;
+
+/*
+ * Optional override, so the routers can be moved without a rebuild:
+ *   NVTOP_LLM_SERVERS="llama=127.0.0.1:55555=7900;llamb=127.0.0.1:55556=1030"
+ * The third field is a substring matched against the GPU device name to decide
+ * which GPU block the meter belongs to.
+ */
+static void servers_init(void) {
+  static bool done = false;
+  const char *env, *p;
+  unsigned n = 0;
+
+  if (done)
+    return;
+  done = true;
+
+  env = getenv("NVTOP_LLM_SERVERS");
+  if (!env || !*env)
+    return;
+
+  p = env;
+  while (*p && n < NVTOP_LLM_MAX_SERVERS) {
+    char buf[256];
+    size_t len = 0;
+    char *eq1, *eq2, *hint = NULL;
+
+    while (*p && *p != ';' && len < sizeof(buf) - 1)
+      buf[len++] = *p++;
+    buf[len] = '\0';
+    if (*p == ';')
+      p++;
+    if (!buf[0])
+      continue;
+
+    eq1 = strchr(buf, '=');
+    if (!eq1)
+      continue;
+    *eq1 = '\0';
+    eq2 = strchr(eq1 + 1, '=');
+    if (eq2) {
+      *eq2 = '\0';
+      hint = eq2 + 1;
+    }
+
+    snprintf(g_defs[n].name, sizeof(g_defs[n].name), "%s", buf);
+    snprintf(g_defs[n].host, sizeof(g_defs[n].host), "%s", eq1 + 1);
+    snprintf(g_defs[n].gpu_hint, sizeof(g_defs[n].gpu_hint), "%s", hint ? hint : "");
+    n++;
+  }
+  if (n)
+    g_def_count = n;
+}
