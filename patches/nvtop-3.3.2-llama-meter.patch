+  for (int r = 0; r < rows && (unsigned)r < info->loaded_count; r++) {
+    const nvtop_llm_model *m = &info->models[r];
+    unsigned remaining = info->loaded_count - (unsigned)r - 1;
+
+    llm_model_facts(m, facts, sizeof(facts), false);
+
+    line[0] = '\0';
+    llm_append(line, sizeof(line), " %s", info->server_name);
+    if (m->state == NVTOP_LLM_LOADING)
+      llm_append(line, sizeof(line), " loading");
+    llm_append(line, sizeof(line), "  %s", m->model_name);
+    if (facts[0])
+      llm_append(line, sizeof(line), "  %s", facts);
+    if (m->state == NVTOP_LLM_LOADING && m->has_load_progress)
+      llm_append(line, sizeof(line), "  load %u%%", m->load_pct);
+    else if (m->state == NVTOP_LLM_LOADING && m->load_stalled)
