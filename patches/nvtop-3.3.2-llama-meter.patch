+/* ------------------------------------------------------------------ */
+/* LLM model meter                                                     */
+/* ------------------------------------------------------------------ */
+
+static void llm_append(char *buf, size_t cap, const char *fmt, ...) {
+  size_t len = strlen(buf);
+  va_list ap;
+
+  if (len + 1 >= cap)
+    return;
+  va_start(ap, fmt);
+  vsnprintf(buf + len, cap - len, fmt, ap);
+  va_end(ap);
+}
+
+static void llm_fmt_count(char *out, size_t cap, uint64_t v) {
+  if (v >= 1000000000ull)
+    snprintf(out, cap, "%.1fB", (double)v / 1000000000.0);
+  else if (v >= 1000000ull)
+    snprintf(out, cap, "%.1fM", (double)v / 1000000.0);
+  else if (v >= 1000ull)
+    snprintf(out, cap, "%.1fk", (double)v / 1000.0);
+  else
+    snprintf(out, cap, "%llu", (unsigned long long)v);
+}
+
+static void llm_fmt_bytes(char *out, size_t cap, uint64_t v) {
+  if (v >= 1000000000ull)
+    snprintf(out, cap, "%.1fG", (double)v / 1000000000.0);
+  else if (v >= 1000000ull)
+    snprintf(out, cap, "%.0fM", (double)v / 1000000.0);
+  else
+    snprintf(out, cap, "%.0fK", (double)v / 1000.0);
+}
+
+/* Compact facts for one model. `full` adds the training context, parameter
+ * count, quantisation and KV cache types, which only fit on a dedicated row. */
+static void llm_model_facts(const nvtop_llm_model *m, char *out, size_t cap, bool full) {
+  char tmp[32];
+
+  out[0] = '\0';
+  if (m->ctx_size) {
+    llm_fmt_count(tmp, sizeof(tmp), m->ctx_size);
+    llm_append(out, cap, "ctx %s", tmp);
+  }
+  if (full && m->ctx_train) {
+    llm_fmt_count(tmp, sizeof(tmp), m->ctx_train);
+    llm_append(out, cap, "  train %s", tmp);
+  }
+  if (m->model_size_bytes) {
+    llm_fmt_bytes(tmp, sizeof(tmp), m->model_size_bytes);
+    llm_append(out, cap, "  %s", tmp);
+  }
+  if (full && m->n_params) {
+    llm_fmt_count(tmp, sizeof(tmp), m->n_params);
+    llm_append(out, cap, "  %s", tmp);
+  }
+  if (full && m->parallel > 1) {
+    snprintf(tmp, sizeof(tmp), "%u", m->parallel);
+    llm_append(out, cap, "  slots %s", tmp);
+  }
+  if (full && m->ftype[0])
+    llm_append(out, cap, "  %s", m->ftype);
+  if (full && m->kv_type_k[0] && m->kv_type_v[0])
+    llm_append(out, cap, "  kv %s/%s", m->kv_type_k, m->kv_type_v);
+}
+
+/* Live KV-cache load bar, drawn like the GPU/MEM meters. */
+static void llm_draw_ctx_bar(WINDOW *win, int row, int cols, const nvtop_llm_model *m) {
+  char pct[16], tail[128];
+  int label = 4, bar, filled;
+
+  snprintf(pct, sizeof(pct), "%u%%", m->kv_usage_pct);
+  if (m->kv_tokens_total)
+    snprintf(tail, sizeof(tail), " %s  %llu/%llu", pct, (unsigned long long)m->kv_tokens,
+             (unsigned long long)m->kv_tokens_total);
+  else
+    snprintf(tail, sizeof(tail), " %s", pct);
+
+  bar = cols - label - 3 - (int)strlen(tail);
+  if (bar < 1)
+    bar = 1;
+  filled = (int)((double)bar * (double)m->kv_usage_pct / 100.0);
+  if (filled > bar)
+    filled = bar;
+
+  wcolor_set(win, cyan_color, NULL);
+  mvwprintw(win, row, 0, "CTX");
+  wstandend(win);
+  mvwaddch(win, row, label, '[');
+  if (filled > 0)
+    whline(win, '|', filled);
+  if (bar - filled > 0)
+    mvwhline(win, row, label + 1 + filled, ' ', bar - filled);
+  mvwaddch(win, row, label + 1 + bar, ']');
+  mvwprintw(win, row, label + 2 + bar, "%.*s", cols - (label + 2 + bar) - 1, tail);
+}
+
+/*
+ * One line per model the router is running, e.g. on the GT 1030:
+ *   LLM llamb  granite-docling-258M-Q8_0     ctx 8k   258M
+ *   LLM llamb  Qwen3-Embedding-0.6B-Q8_0     ctx 4k   633M
+ *
+ * With a single model there is room to spare, so the name gets its own line
+ * and the second line shows either the live context bar or the full facts:
+ *   LLM llama  Qwen3.5-35B-A3B-UD-IQ4_XS-240k
+ *   CTX [||||||||        ] 41%  1234/245760
+ */
+static void draw_llm_meter(WINDOW *win, const nvtop_model_meter_info *info) {
+  int rows, cols;
+  char line[512], facts[256];
+
+  getmaxyx(win, rows, cols);
+  werase(win);
+  if (cols <= 8)
+    return;
+
+  /* No router on the socket, or nothing running. */
+  if (info->state == NVTOP_LLM_SERVER_DOWN || info->loaded_count == 0) {
+    wcolor_set(win, cyan_color, NULL);
+    mvwprintw(win, 0, 0, "LLM");
+    wstandend(win);
+    if (info->state == NVTOP_LLM_SERVER_DOWN)
+      snprintf(line, sizeof(line), " %s  router not reachable", info->server_name);
+    else
+      snprintf(line, sizeof(line), " %s  idle, none loaded", info->server_name);
+    mvwprintw(win, 0, 3, "%.*s", cols - 4, line);
+
+    if (rows >= 2) {
+      if (info->state == NVTOP_LLM_SERVER_DOWN)
+        snprintf(line, sizeof(line), "no connection to the router");
+      else
+        snprintf(line, sizeof(line), "%u presets advertised, loaded on demand", info->preset_count);
+      mvwprintw(win, 1, 0, "%.*s", cols - 1, line);
+    }
+    wnoutrefresh(win);
+    return;
+  }
+
+  /* Exactly one model: name on line 0, details on line 1. */
+  if (info->loaded_count == 1 && rows >= 2) {
+    const nvtop_llm_model *m = &info->models[0];
+
+    wcolor_set(win, cyan_color, NULL);
+    mvwprintw(win, 0, 0, "LLM");
+    wstandend(win);
+
+    line[0] = '\0';
+    llm_append(line, sizeof(line), " %s", info->server_name);
+    if (m->state == NVTOP_LLM_LOADING)
+      llm_append(line, sizeof(line), " loading");
+    llm_append(line, sizeof(line), "  %s", m->model_name);
+    mvwprintw(win, 0, 3, "%.*s", cols - 4, line);
+
+    if (m->has_live_ctx) {
+      llm_draw_ctx_bar(win, 1, cols, m);
+    } else {
+      llm_model_facts(m, facts, sizeof(facts), true);
+      mvwprintw(win, 1, 0, "%.*s", cols - 1, facts[0] ? facts : "model loaded");
+    }
+    wnoutrefresh(win);
+    return;
+  }
+
+  /* Several models running at once (llama.cpp `max_instances`): one line each,
+   * facts inline, truncated if they do not all fit. */
+  for (int r = 0; r < rows && (unsigned)r < info->loaded_count; r++) {
+    const nvtop_llm_model *m = &info->models[r];
+    unsigned remaining = info->loaded_count - (unsigned)r - 1;
+
+    llm_model_facts(m, facts, sizeof(facts), false);
+
+    line[0] = '\0';
+    llm_append(line, sizeof(line), " %s", info->server_name);
+    if (m->state == NVTOP_LLM_LOADING)
+      llm_append(line, sizeof(line), " loading");
+    llm_append(line, sizeof(line), "  %s", m->model_name);
+    if (facts[0])
+      llm_append(line, sizeof(line), "  %s", facts);
+    if (m->has_live_ctx)
+      llm_append(line, sizeof(line), "  kv %u%%", m->kv_usage_pct);
+    /* Never let a running model vanish silently when there are more of them
+     * than there are rows to show them on. */
+    if (r == rows - 1 && remaining > 0)
+      llm_append(line, sizeof(line), "  +%u more", remaining);
+
+    if (r == 0) {
+      wcolor_set(win, cyan_color, NULL);
+      mvwprintw(win, r, 0, "LLM");
+      wstandend(win);
+    }
+    mvwprintw(win, r, 3, "%.*s", cols - 4, line);
+  }
+
+  wnoutrefresh(win);
+}
