+
+/* Real vertical extent of the plot area. Plots that share a stack all report
+ * the same posY/sizeY, so this must be measured over the area, not summed per
+ * plot, or side-by-side charts get counted twice. */
+static unsigned plot_area_rows(const struct window_position *plot_positions, unsigned num_plots) {
+  unsigned top = 0, bottom = 0;
+  bool first = true;
+
+  for (unsigned p = 0; p < num_plots; p++) {
+    if (first || plot_positions[p].posY < top)
+      top = plot_positions[p].posY;
+    if (first || plot_positions[p].posY + plot_positions[p].sizeY > bottom)
+      bottom = plot_positions[p].posY + plot_positions[p].sizeY;
+    first = false;
+  }
+  return num_plots ? bottom - top : 0;
+}
