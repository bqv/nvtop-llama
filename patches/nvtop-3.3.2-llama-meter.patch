+/* One layout pass. Called a few times at startup to pick how much room the LLM
+ * meter may take without costing the plots anything. */
+static void compute_layout_for_interface(struct nvtop_interface *dwin, unsigned devices_count, unsigned header_rows,
+                                         unsigned rows, unsigned cols, const unsigned *device_extra_rows,
+                                         struct window_position *device_positions,
+                                         struct window_position plot_positions[MAX_CHARTS],
+                                         unsigned *map_device_to_plot, struct window_position *process_position,
+                                         struct window_position *setup_position) {
+  compute_sizes_from_layout(devices_count, header_rows, device_length(), rows - 1, cols, dwin->options.gpu_specific_opts,
+                            dwin->options.process_fields_displayed, device_extra_rows, device_positions, &dwin->num_plots, plot_positions,
+                            map_device_to_plot, process_position, setup_position, dwin->options.hide_processes_list);
+}
+
+/* Real vertical extent of the plot area. Plots that share a stack all report
+ * the same posY/sizeY, so this must be measured over the area, not summed per
+ * plot, or side-by-side charts get counted twice. */
+static unsigned plot_area_rows(const struct window_position *plot_positions, unsigned num_plots) {
+  unsigned top = 0, bottom = 0;
+  bool first = true;
+
+  for (unsigned p = 0; p < num_plots; p++) {
+    if (first || plot_positions[p].posY < top)
+      top = plot_positions[p].posY;
+    if (first || plot_positions[p].posY + plot_positions[p].sizeY > bottom)
+      bottom = plot_positions[p].posY + plot_positions[p].sizeY;
+    first = false;
+  }
+  return num_plots ? bottom - top : 0;
+}
+
+/* True when a router is configured for this GPU. Independent of the poll, so it
+ * can be asked while the layout is being computed. */
+static bool gpu_has_llm_router(struct nvtop_interface *dwin, unsigned dev_id) {
+  struct gpu_info *gpu = dwin->options.gpu_specific_opts[dev_id].linkedGpu;
+  return gpu && GPUINFO_STATIC_FIELD_VALID(&gpu->static_info, device_name) &&
+         nvtop_model_meter_has_router_for_gpu(gpu->static_info.device_name);
+}
