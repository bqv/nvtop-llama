+#ifndef NVTOP_MODEL_METER_C_H__
+#define NVTOP_MODEL_METER_C_H__
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define NVTOP_LLM_MAX_SERVERS 4
+#define NVTOP_LLM_SERVER_NAME_MAX 24
+#define NVTOP_LLM_GPU_HINT_MAX 32
+#define NVTOP_LLM_MODEL_NAME_MAX 192
+#define NVTOP_LLM_FTYPE_MAX 32
+#define NVTOP_LLM_KVTYPE_MAX 12
+
+/* A router can serve several models at once (llama.cpp `max_instances`), so
+ * one server holds a list of them. */
+#define NVTOP_LLM_MAX_LOADED 4
+
+/* State of one model on a router */
+typedef enum {
+  NVTOP_LLM_SERVER_DOWN = 0, /* nothing answered on the socket */
+  NVTOP_LLM_IDLE,            /* router answered, this model is not running */
+  NVTOP_LLM_LOADING,
+  NVTOP_LLM_LOADED,
+} nvtop_llm_state;
+
+/* One model instance on a router */
+typedef struct nvtop_llm_model {
+  char model_name[NVTOP_LLM_MODEL_NAME_MAX];
+  nvtop_llm_state state;
+
+  /* Static facts, from meta{} (falls back to status.args) */
+  unsigned ctx_size;  /* meta.n_ctx / --ctx-size */
+  unsigned ctx_train; /* meta.n_ctx_train */
+  unsigned parallel;  /* --parallel */
+  char kv_type_k[NVTOP_LLM_KVTYPE_MAX];
+  char kv_type_v[NVTOP_LLM_KVTYPE_MAX];
+  uint64_t model_size_bytes;       /* meta.size */
+  uint64_t n_params;               /* meta.n_params */
+  char ftype[NVTOP_LLM_FTYPE_MAX]; /* meta.ftype */
+
+  /* Live context load, best effort (/metrics?model=...). The router returns
+   * HTTP 500 when the child instance is not reachable, in which case
+   * has_live_ctx stays false and the UI shows the static facts instead. */
+  bool has_live_ctx;
+  unsigned kv_usage_pct;
+  uint64_t kv_tokens;
+  uint64_t kv_tokens_total;
+} nvtop_llm_model;
+
+/* One llama.cpp router server, mapped to one GPU */
+typedef struct nvtop_model_meter_info {
+  char server_name[NVTOP_LLM_SERVER_NAME_MAX]; /* "llama" */
+  char gpu_hint[NVTOP_LLM_GPU_HINT_MAX];       /* substring matched in the GPU name */
+  bool reachable;
+
+  /* Aggregate over models[]: LOADED if any is loaded, LOADING if any is
+   * loading, IDLE if the router answered with nothing running. */
+  nvtop_llm_state state;
+
+  unsigned preset_count; /* how many models the router advertises */
+  unsigned loaded_count; /* valid entries in models[] */
+  nvtop_llm_model models[NVTOP_LLM_MAX_LOADED];
+} nvtop_model_meter_info;
+
+/* Poll every configured server. Cheap no-op when called more often than the
+ * internal minimum interval. Returns true if at least one server answered. */
+bool nvtop_model_meter_poll(void);
+
+/* Number of servers that have been polled */
+unsigned nvtop_model_meter_count(void);
+
+/* Info for server idx, or NULL when out of range */
+const nvtop_model_meter_info *nvtop_model_meter_get(unsigned idx);
+
+/* Best match for a GPU device name (e.g. "AMD Radeon RX 7900 XT" -> llama),
+ * or NULL when no configured server maps to that GPU. */
+const nvtop_model_meter_info *nvtop_model_meter_for_gpu(const char *gpu_name);
+
+void nvtop_model_meter_shutdown(void);
+
+#endif /* NVTOP_MODEL_METER_C_H__ */
