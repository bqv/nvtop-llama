+/* ------------------------------------------------------------------ */
+/* HTTP                                                                */
+/* ------------------------------------------------------------------ */
+
+struct membuf {
+  char *buf;
+  size_t len;
+  size_t cap;
+};
+
+static size_t curl_write_cb(char *ptr, size_t size, size_t nmemb, void *userdata) {
+  struct membuf *m = (struct membuf *)userdata;
+  size_t n = size * nmemb;
+  if (n > m->cap - 1 - m->len)
+    n = (m->cap - 1 > m->len) ? (m->cap - 1 - m->len) : 0;
+  if (n) {
+    memcpy(m->buf + m->len, ptr, n);
+    m->len += n;
+    m->buf[m->len] = '\0';
+  }
+  return size * nmemb; /* always consume everything, never abort the transfer */
+}
+
+static bool http_get(const char *host, const char *path, char *out, size_t cap, long *http_code) {
+  char url[512];
+  struct membuf m = {out, 0, cap};
+
+  if (cap)
+    out[0] = '\0';
+  if (!g_curl)
+    return false;
+
+  snprintf(url, sizeof(url), "http://%s%s", host, path);
+
+  curl_easy_setopt(g_curl, CURLOPT_URL, url);
+  curl_easy_setopt(g_curl, CURLOPT_WRITEFUNCTION, curl_write_cb);
+  curl_easy_setopt(g_curl, CURLOPT_WRITEDATA, &m);
+  curl_easy_setopt(g_curl, CURLOPT_NOSIGNAL, 1L);
+  curl_easy_setopt(g_curl, CURLOPT_CONNECTTIMEOUT_MS, 400L);
+  curl_easy_setopt(g_curl, CURLOPT_TIMEOUT_MS, 1200L);
+  curl_easy_setopt(g_curl, CURLOPT_FOLLOWLOCATION, 0L);
+  curl_easy_setopt(g_curl, CURLOPT_USERAGENT, "nvtop-llm-meter");
+
+  if (curl_easy_perform(g_curl) != CURLE_OK)
+    return false;
+
+  if (http_code) {
+    long code = 0;
+    curl_easy_getinfo(g_curl, CURLINFO_RESPONSE_CODE, &code);
+    *http_code = code;
+  }
+  return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Minimal, bounded JSON helpers                                       */
+/* ------------------------------------------------------------------ */
+
+/* p points at the opening quote; returns the position just past the closing
+ * quote, or the terminating NUL when unterminated. */
+static const char *skip_json_string(const char *p) {
+  p++;
+  while (*p) {
+    if (*p == '\\' && p[1]) {
+      p += 2;
+      continue;
+    }
+    if (*p == '"')
+      return p + 1;
+    p++;
+  }
+  return p;
+}
+
+/* p points at '{' or '['; returns the matching closer, or NULL. */
+static const char *match_pair(const char *p) {
+  char open = *p;
+  char close = (open == '{') ? '}' : ']';
+  int depth = 0;
+
+  while (*p) {
+    if (*p == '"') {
+      p = skip_json_string(p);
+      continue;
+    }
+    if (*p == open)
+      depth++;
+    else if (*p == close) {
+      depth--;
+      if (depth == 0)
+        return p;
+    }
+    p++;
+  }
+  return NULL;
+}
+
+/* Search for "key" within [s,e); returns the position just after the ':'. */
+static const char *key_in(const char *s, const char *e, const char *key) {
+  size_t klen = strlen(key);
+  const char *p = s;
+
+  while (p && p < e) {
+    if (*p == '"') {
+      const char *after = skip_json_string(p);
+      if ((size_t)(after - p) == klen + 2 && strncmp(p + 1, key, klen) == 0) {
+        const char *c = after;
+        while (c < e && isspace((unsigned char)*c))
+          c++;
+        if (c < e && *c == ':')
+          return c + 1;
+        return NULL;
+      }
+      p = after;
+      continue;
+    }
+    p++;
+  }
+  return NULL;
+}
+
+static const char *json_string(const char *p, char *out, size_t cap) {
+  size_t i = 0;
+
+  while (*p && isspace((unsigned char)*p))
+    p++;
+  if (*p != '"') {
+    if (cap)
+      out[0] = '\0';
+    return NULL;
+  }
+  p++;
+  while (*p && *p != '"') {
+    char c = *p;
+    if (c == '\\' && p[1]) {
+      p++;
+      c = *p;
+      if (c == 'n')
+        c = '\n';
+      else if (c == 't')
+        c = '\t';
+      else if (c == 'r')
+        c = '\r';
+    }
+    if (i + 1 < cap)
+      out[i++] = c;
+    p++;
+  }
+  if (cap)
+    out[i] = '\0';
+  return (*p == '"') ? p + 1 : p;
+}
+
+/* Accepts both bare numbers and numbers quoted as strings. */
+static bool json_u64(const char *p, uint64_t *out) {
+  while (*p && isspace((unsigned char)*p))
+    p++;
+  if (*p == '"')
+    p++;
+  if (!isdigit((unsigned char)*p))
+    return false;
+  uint64_t v = 0;
+  while (isdigit((unsigned char)*p)) {
+    v = v * 10 + (uint64_t)(*p - '0');
+    p++;
+  }
+  *out = v;
+  return true;
+}
+
+/* Look up the value following `flag` inside a JSON string array. */
+static bool args_lookup(const char *arr, const char *arr_end, const char *flag, char *out, size_t cap) {
+  char cur[256];
+  const char *p = arr;
+
+  if (p >= arr_end || *p != '[')
+    return false;
+  p++;
+  while (p < arr_end) {
+    while (p < arr_end && *p != '"')
+      p++;
+    if (p >= arr_end)
+      break;
+    const char *after = json_string(p, cur, sizeof(cur));
+    if (!after || after > arr_end)
+      break;
+    if (strcmp(cur, flag) == 0) {
+      const char *q = after;
+      while (q < arr_end && *q != '"')
+        q++;
+      if (q < arr_end) {
+        json_string(q, out, cap);
+        return true;
+      }
+      return false;
+    }
+    p = after;
+  }
+  return false;
+}
+
+/* ------------------------------------------------------------------ */
+/* /v1/models                                                          */
+/* ------------------------------------------------------------------ */
+
+static void model_object_parse(const char *obj, const char *obj_end, nvtop_llm_model *dst) {
+  const char *v;
+
+  if ((v = key_in(obj, obj_end, "id")))
+    json_string(v, dst->model_name, sizeof(dst->model_name));
+
+  if ((v = key_in(obj, obj_end, "status"))) {
+    while (v < obj_end && isspace((unsigned char)*v))
+      v++;
+    if (v < obj_end && *v == '{') {
+      const char *send = match_pair(v);
+      if (send && send <= obj_end) {
+        const char *val = key_in(v, send, "value");
+        if (val) {
+          char s[32] = "";
+          json_string(val, s, sizeof(s));
+          if (strcmp(s, "loaded") == 0)
+            dst->state = NVTOP_LLM_LOADED;
+          else if (strcmp(s, "loading") == 0)
+            dst->state = NVTOP_LLM_LOADING;
+          else
+            dst->state = NVTOP_LLM_IDLE;
+        }
+        const char *args = key_in(v, send, "args");
+        if (args) {
+          while (args < send && isspace((unsigned char)*args))
+            args++;
+          if (args < send && *args == '[') {
+            const char *aend = match_pair(args);
+            if (aend && aend <= send) {
+              char tmp[64];
+              if (args_lookup(args, aend, "--ctx-size", tmp, sizeof(tmp)))
+                dst->ctx_size = (unsigned)strtoul(tmp, NULL, 10);
+              if (args_lookup(args, aend, "--parallel", tmp, sizeof(tmp)))
+                dst->parallel = (unsigned)strtoul(tmp, NULL, 10);
+              args_lookup(args, aend, "--cache-type-k", dst->kv_type_k, sizeof(dst->kv_type_k));
+              args_lookup(args, aend, "--cache-type-v", dst->kv_type_v, sizeof(dst->kv_type_v));
+              args_lookup(args, aend, "--model", dst->model_arg, sizeof(dst->model_arg));
+            }
+          }
+        }
+      }
+    }
+  }
+
+  if ((v = key_in(obj, obj_end, "meta"))) {
+    while (v < obj_end && isspace((unsigned char)*v))
+      v++;
+    if (v < obj_end && *v == '{') {
+      const char *mend = match_pair(v);
+      if (mend && mend <= obj_end) {
+        const char *k;
+        uint64_t n = 0;
+        if ((k = key_in(v, mend, "n_ctx")) && json_u64(k, &n))
+          dst->ctx_size = (unsigned)n;
+        if ((k = key_in(v, mend, "n_ctx_train")) && json_u64(k, &n))
+          dst->ctx_train = (unsigned)n;
+        if ((k = key_in(v, mend, "n_params")) && json_u64(k, &n))
+          dst->n_params = n;
+        if ((k = key_in(v, mend, "size")) && json_u64(k, &n))
+          dst->model_size_bytes = n;
+        if ((k = key_in(v, mend, "ftype")))
+          json_string(k, dst->ftype, sizeof(dst->ftype));
+      }
+    }
+  }
+}
+
+/* Collect every model the router is actually running. */
+static void parse_models_list(const char *json, nvtop_model_meter_info *info) {
+  const char *data = key_in(json, json + strlen(json), "data");
+  const char *p, *arr_end, *it;
+  unsigned count = 0, loading = 0;
+
+  if (!data)
+    return;
+  p = data;
+  while (*p && isspace((unsigned char)*p))
+    p++;
+  if (*p != '[')
+    return;
+  arr_end = match_pair(p);
+  if (!arr_end)
+    return;
+
+  it = p + 1;
+  while (it < arr_end) {
+    const char *oend;
+    nvtop_llm_model tmp;
+
+    while (it < arr_end && *it != '{')
+      it++;
+    if (it >= arr_end)
+      break;
+    oend = match_pair(it);
+    if (!oend || oend > arr_end)
+      break;
+
+    count++;
+    memset(&tmp, 0, sizeof(tmp));
+    model_object_parse(it, oend, &tmp);
+
+    if (tmp.state == NVTOP_LLM_LOADED) {
+      if (info->loaded_count < NVTOP_LLM_MAX_LOADED)
+        info->models[info->loaded_count++] = tmp;
+    } else if (tmp.state == NVTOP_LLM_LOADING) {
+      loading++;
+      if (info->loaded_count < NVTOP_LLM_MAX_LOADED)
+        info->models[info->loaded_count++] = tmp;
+    }
+    it = oend + 1;
+  }
+
+  info->preset_count = count;
+  if (info->loaded_count == 0)
+    info->state = NVTOP_LLM_IDLE;
+  else if (loading && info->loaded_count == loading)
+    info->state = NVTOP_LLM_LOADING;
+  else
+    info->state = NVTOP_LLM_LOADED;
+}
+
+/* ------------------------------------------------------------------ */
+/* /metrics?model=...  (best effort, prometheus text)                  */
+/* ------------------------------------------------------------------ */
+
+static bool last_token_double(const char *line, size_t len, double *out) {
+  size_t end = len, start;
+  char tmp[64];
+  size_t n;
+
+  while (end > 0 && isspace((unsigned char)line[end - 1]))
+    end--;
+  start = end;
+  while (start > 0 && !isspace((unsigned char)line[start - 1]))
+    start--;
+  n = end - start;
+  if (!n)
+    return false;
+  if (n >= sizeof(tmp))
+    n = sizeof(tmp) - 1;
+  memcpy(tmp, line + start, n);
+  tmp[n] = '\0';
+
+  char *endp = NULL;
+  double v = strtod(tmp, &endp);
+  if (endp == tmp)
+    return false;
+  *out = v;
+  return true;
+}
+
+static void parse_prometheus(const char *text, nvtop_llm_model *model) {
+  const char *p = text;
+
+  while (*p) {
+    const char *nl = strchr(p, '\n');
+    size_t len = nl ? (size_t)(nl - p) : strlen(p);
+    double v;
+
+    if (len) {
+      const char *m = strstr(p, "kv_cache_usage_ratio");
+      if (m && (size_t)(m - p) < len) {
+        if (last_token_double(p, len, &v)) {
+          if (v > 1.0)
+            v = 1.0;
+          if (v < 0.0)
+            v = 0.0;
+          model->kv_usage_pct = (unsigned)(v * 100.0 + 0.5);
+          model->has_live_ctx = true;
+        }
+      } else if ((m = strstr(p, "kv_cache_tokens_total")) && (size_t)(m - p) < len) {
+        if (last_token_double(p, len, &v) && v >= 0.0)
+          model->kv_tokens_total = (uint64_t)v;
+      } else if ((m = strstr(p, "kv_cache_tokens")) && (size_t)(m - p) < len) {
+        if (last_token_double(p, len, &v) && v >= 0.0)
+          model->kv_tokens = (uint64_t)v;
+      }
+    }
+    if (!nl)
+      break;
+    p = nl + 1;
+  }
+}
+
+static void url_encode(const char *in, char *out, size_t cap) {
+  static const char hex[] = "0123456789ABCDEF";
+  size_t o = 0;
+
+  for (; *in && o + 4 < cap; in++) {
+    unsigned char c = (unsigned char)*in;
+    if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~')
+      out[o++] = (char)c;
+    else {
+      out[o++] = '%';
+      out[o++] = hex[c >> 4];
+      out[o++] = hex[c & 0x0F];
+    }
+  }
+  out[o] = '\0';
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                          */
+/* ------------------------------------------------------------------ */
+
+/* ------------------------------------------------------------------ */
+/* Cold-load progress, from /proc                                      */
+/* ------------------------------------------------------------------ */
+
+/* The per-model llama-server child is the one carrying --model; the router is
+ * also called llama-server but carries --models-dir instead. */
+static bool cmdline_arg(const char *cmd, size_t len, const char *flag, char *out, size_t cap) {
+  size_t i = 0;
+  while (i < len) {
+    const char *arg = cmd + i;
+    size_t alen = strnlen(arg, len - i);
+    if (alen == 0)
+      break;
+    if (strcmp(arg, flag) == 0 && i + alen + 1 < len) {
+      const char *val = cmd + i + alen + 1;
+      size_t vlen = strnlen(val, len - (i + alen + 1));
+      if (vlen == 0 || vlen >= cap)
+        return false;
+      memcpy(out, val, vlen);
+      out[vlen] = '\0';
+      return true;
+    }
+    i += alen + 1;
+  }
+  return false;
+}
+
+/* read_bytes is the only counter that tracks a cold load (see load-mode = dio). */
+static long read_proc_read_bytes(long pid) {
+  char path[64], buf[512];
+  long v = -1;
+  FILE *f;
+
+  snprintf(path, sizeof(path), "/proc/%ld/io", pid);
+  f = fopen(path, "r");
+  if (!f)
+    return -1;
+  while (fgets(buf, sizeof(buf), f)) {
+    if (strncmp(buf, "read_bytes:", 11) == 0) {
+      v = strtol(buf + 11, NULL, 10);
+      break;
+    }
+  }
+  fclose(f);
+  return v;
+}
+
+#define LLM_LOAD_SAMPLES (NVTOP_LLM_MAX_SERVERS * NVTOP_LLM_MAX_LOADED)
+
+/* Previous sample per model, so a rate and an ETA can be derived. */
+static struct {
+  char model[NVTOP_LLM_MODEL_NAME_MAX];
+  uint64_t read_bytes;
+  struct timespec at;
+} g_load_prev[LLM_LOAD_SAMPLES];
+
+static void poll_load_progress(nvtop_llm_model *m) {
+  const char *want_base;
+  DIR *d;
+  struct dirent *e;
+
+  m->has_load_progress = false;
+  m->load_stalled = false;
+  m->load_bytes_per_s = 0.0;
+  m->load_eta_s = 0.0;
+  if (!m->model_arg[0])
+    return;
+  want_base = strrchr(m->model_arg, '/');
+  want_base = want_base ? want_base + 1 : m->model_arg;
+
+  d = opendir("/proc");
+  if (!d)
+    return;
+  while ((e = readdir(d)) != NULL) {
+    char path[64], comm[32], cmd[4096], arg[NVTOP_LLM_MODEL_NAME_MAX], full[PATH_MAX];
+    const char *base;
+    long pid, read_bytes;
+    struct stat st;
+    FILE *f;
+    size_t n;
+
+    if (!isdigit((unsigned char)e->d_name[0]))
+      continue;
+    pid = strtol(e->d_name, NULL, 10);
+    if (pid <= 0)
+      continue;
+
+    snprintf(path, sizeof(path), "/proc/%ld/comm", pid);
+    f = fopen(path, "r");
+    if (!f)
+      continue;
+    if (!fgets(comm, sizeof(comm), f)) {
+      fclose(f);
+      continue;
+    }
+    fclose(f);
+    if (strncmp(comm, "llama-server", 12) != 0)
+      continue;
+
+    snprintf(path, sizeof(path), "/proc/%ld/cmdline", pid);
+    f = fopen(path, "rb");
+    if (!f)
+      continue;
+    n = fread(cmd, 1, sizeof(cmd) - 1, f);
+    fclose(f);
+    cmd[n] = '\0';
+    if (!cmdline_arg(cmd, n, "--model", arg, sizeof(arg)))
+      continue; /* the router */
+
+    base = strrchr(arg, '/');
+    base = base ? base + 1 : arg;
+    if (strcmp(base, want_base) != 0)
+      continue;
+
+    /* The child's --model is relative (the router runs it with the models dir
+     * as cwd), so resolve it through /proc/<pid>/cwd. */
+    if (arg[0] == '/') {
+      snprintf(full, sizeof(full), "%s", arg);
+    } else {
+      char cwd[PATH_MAX], link[64];
+      ssize_t cl;
+      snprintf(link, sizeof(link), "/proc/%ld/cwd", pid);
+      cl = readlink(link, cwd, sizeof(cwd) - 1);
+      if (cl <= 0)
+        continue;
+      cwd[cl] = '\0';
+      snprintf(full, sizeof(full), "%s/%s", cwd, arg);
+    }
+    if (stat(full, &st) != 0 || st.st_size <= 0)
+      continue;
+    read_bytes = read_proc_read_bytes(pid);
+    if (read_bytes < 0)
+      continue;
+
+    m->load_read_bytes = (uint64_t)read_bytes;
+    m->load_total_bytes = (uint64_t)st.st_size;
+    {
+      double pct = 100.0 * (double)read_bytes / (double)st.st_size;
+      if (pct > 100.0)
+        pct = 100.0; /* read_bytes counts other reads too */
+      m->load_pct = (unsigned)(pct + 0.5);
+    }
+    m->has_load_progress = true;
+
+    /* Rate and ETA, plus a genuine "the counter is not moving" verdict: under
+     * mmap loading read_bytes stalls, and a frozen bar would be a lie. */
+    {
+      unsigned slot = 0, free_slot = LLM_LOAD_SAMPLES;
+      struct timespec now;
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      for (unsigned i = 0; i < LLM_LOAD_SAMPLES; i++) {
+        if (strcmp(g_load_prev[i].model, m->model_name) == 0) {
+          slot = i;
+          free_slot = i;
+          break;
+        }
+        if (free_slot == LLM_LOAD_SAMPLES && !g_load_prev[i].model[0])
+          free_slot = i;
+      }
+      if (g_load_prev[slot].model[0]) {
+        double dt = (double)(now.tv_sec - g_load_prev[slot].at.tv_sec) +
+                    (double)(now.tv_nsec - g_load_prev[slot].at.tv_nsec) / 1e9;
+        if (dt > 0.2) {
+          if ((uint64_t)read_bytes > g_load_prev[slot].read_bytes) {
+            m->load_bytes_per_s = (double)((uint64_t)read_bytes - g_load_prev[slot].read_bytes) / dt;
+            if (m->load_bytes_per_s > 0)
+              m->load_eta_s = (double)((uint64_t)st.st_size - (uint64_t)read_bytes) / m->load_bytes_per_s;
+          } else {
+            m->load_stalled = true;
+            m->has_load_progress = false;
+          }
+        }
+      }
+      if (free_slot < LLM_LOAD_SAMPLES) {
+        snprintf(g_load_prev[free_slot].model, sizeof(g_load_prev[free_slot].model), "%s", m->model_name);
+        g_load_prev[free_slot].read_bytes = (uint64_t)read_bytes;
+        g_load_prev[free_slot].at = now;
+      }
+    }
+    break;
+  }
+  closedir(d);
+}
+
+static bool min_interval_elapsed(void) {
+  struct timespec now;
+  long ms;
+
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  ms = (now.tv_sec - g_last_poll.tv_sec) * 1000L + (now.tv_nsec - g_last_poll.tv_nsec) / 1000000L;
+  return ms >= LLM_MIN_POLL_MS;
+}
+
+bool nvtop_model_meter_poll(void) {
+  bool any = false;
+
+  servers_init();
+
+  if (!g_curl_ready) {
+    if (curl_global_init(CURL_GLOBAL_ALL) != CURLE_OK)
+      return false;
+    g_curl = curl_easy_init();
+    if (!g_curl)
+      return false;
+    g_curl_ready = true;
+  }
+
+  if (g_ready && !min_interval_elapsed())
+    return true;
+
+  for (unsigned i = 0; i < g_def_count && i < NVTOP_LLM_MAX_SERVERS; i++) {
+    nvtop_model_meter_info *info = &g_servers[i];
+    long code = 0;
+
+    memset(info, 0, sizeof(*info));
+    snprintf(info->server_name, sizeof(info->server_name), "%s", g_defs[i].name);
+    snprintf(info->gpu_hint, sizeof(info->gpu_hint), "%s", g_defs[i].gpu_hint);
+    info->state = NVTOP_LLM_SERVER_DOWN;
+
+    if (!http_get(g_defs[i].host, LLM_MODELS_PATH, g_body, sizeof(g_body), &code))
+      continue;
+    if (code != 200)
+      continue;
+
+    info->reachable = true;
+    any = true;
+    parse_models_list(g_body, info);
+
+    if (info->loaded_count == 0)
+      continue;
+
+    /* How far a cold load has got, for anything still loading. Kept ahead of
+     * the metrics backoff so progress still works when /metrics is refused. */
+    for (unsigned k = 0; k < info->loaded_count; k++)
+      if (info->models[k].state == NVTOP_LLM_LOADING)
+        poll_load_progress(&info->models[k]);
+
+    /* Live KV load for each running model. If the router cannot serve it, back
+     * off rather than hammering its log with refused requests. */
+    if (g_metrics_backoff[i] > 0) {
+      g_metrics_backoff[i]--;
+      continue;
+    }
+
+    bool got_any = false;
+    for (unsigned k = 0; k < info->loaded_count; k++) {
+      char enc[NVTOP_LLM_MODEL_NAME_MAX * 3];
+      char path[NVTOP_LLM_MODEL_NAME_MAX * 3 + 32];
+
+      if (!info->models[k].model_name[0])
+        continue;
+      url_encode(info->models[k].model_name, enc, sizeof(enc));
+      snprintf(path, sizeof(path), "/metrics?model=%s", enc);
+      if (http_get(g_defs[i].host, path, g_body, sizeof(g_body), &code) && code == 200) {
+        parse_prometheus(g_body, &info->models[k]);
+        if (info->models[k].has_live_ctx)
+          got_any = true;
+      }
+    }
+    if (!got_any)
+      g_metrics_backoff[i] = LLM_METRICS_BACKOFF_POLLS;
+  }
+
+  g_ready = true;
+  clock_gettime(CLOCK_MONOTONIC, &g_last_poll);
+  return any;
+}
+
+unsigned nvtop_model_meter_count(void) {
+  servers_init();
+  return g_ready ? (unsigned)(g_def_count < NVTOP_LLM_MAX_SERVERS ? g_def_count : NVTOP_LLM_MAX_SERVERS) : 0;
+}
+
+const nvtop_model_meter_info *nvtop_model_meter_get(unsigned idx) {
+  if (!g_ready || idx >= g_def_count || idx >= NVTOP_LLM_MAX_SERVERS)
+    return NULL;
+  return &g_servers[idx];
+}
+
+static bool contains_nocase(const char *haystack, const char *needle) {
+  size_t nlen = strlen(needle);
+
+  if (!nlen)
+    return false;
+  for (; *haystack; haystack++) {
+    size_t i = 0;
+    while (i < nlen && haystack[i] && tolower((unsigned char)haystack[i]) == tolower((unsigned char)needle[i]))
+      i++;
+    if (i == nlen)
+      return true;
+  }
+  return false;
+}
+
+/* Answered from the static server config, so it is usable while the layout is
+ * being computed, before any server has been contacted. */
+bool nvtop_model_meter_has_router_for_gpu(const char *gpu_name) {
+  servers_init();
+  if (!gpu_name || !gpu_name[0])
+    return false;
+  for (unsigned i = 0; i < g_def_count && i < NVTOP_LLM_MAX_SERVERS; i++) {
+    if (g_defs[i].gpu_hint[0] && contains_nocase(gpu_name, g_defs[i].gpu_hint))
+      return true;
+  }
+  return false;
+}
+
+const nvtop_model_meter_info *nvtop_model_meter_for_gpu(const char *gpu_name) {
+  if (!g_ready || !gpu_name || !gpu_name[0])
+    return NULL;
+  for (unsigned i = 0; i < g_def_count && i < NVTOP_LLM_MAX_SERVERS; i++) {
+    if (g_servers[i].gpu_hint[0] && contains_nocase(gpu_name, g_servers[i].gpu_hint))
+      return &g_servers[i];
+  }
+  return NULL;
+}
+
+void nvtop_model_meter_shutdown(void) {
+  if (g_curl) {
+    curl_easy_cleanup(g_curl);
+    g_curl = NULL;
+  }
+  if (g_curl_ready)
+    curl_global_cleanup();
+  g_curl_ready = false;
+  g_ready = false;
+}
