+/* Read a sysfs attribute straight from the filesystem.
+ *
+ * libudev's udev_device_get_sysattr_value() caches whatever it reads, so this
+ * file used to create and destroy four udev devices on every refresh purely to
+ * defeat that cache. Each of those parses uevent files and allocates property
+ * strings and hashmap buckets that libudev does not fully release on unref;
+ * with ~10 attributes read per refresh it grew nvtop's heap by ~20 MB/hour for
+ * as long as nvtop ran (measured: +24,797 live blocks in 6 minutes). A plain
+ * read is always current and leaves nothing behind.
+ *
+ * Returns 0 with a NUL-terminated, newline-trimmed value in buf on success. */
+static int read_sysattr(const char *syspath, const char *attr, char *buf, size_t cap) {
+  char path[512];
+  int n;
+
+  if (!syspath || !attr || !cap)
+    return -1;
+  /* udev_device_get_syspath() yields an absolute path, but accept both forms. */
+  n = snprintf(path, sizeof path, "%s%s/%s", syspath[0] == '/' ? "" : "/sys/", syspath, attr);
+  if (n < 0 || (size_t)n >= sizeof path)
+    return -1;
+
+  FILE *f = fopen(path, "r");
+  if (!f)
+    return -1;
+  if (!fgets(buf, (int)cap, f)) {
+    fclose(f);
+    return -1;
+  }
+  fclose(f);
+  size_t len = strlen(buf);
+  while (len && (buf[len - 1] == '\n' || buf[len - 1] == '\r' || buf[len - 1] == ' '))
+    buf[--len] = '\0';
+  return buf[0] ? 0 : -1;
+}
